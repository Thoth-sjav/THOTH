rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    // Verifica que os dois utilizadores são amigos (amizade aceite)
    function saoAmigos(meuUid, amigoUid) {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(meuUid)/amigos/$(amigoUid))
        && get(/databases/$(database)/documents/users/$(meuUid)/amigos/$(amigoUid)).data.estado == 'aceite';
    }

    // ─────────────────────────────────────────────
    // /users/{uid}  — documento raiz do utilizador
    // ─────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // perfil — dono escreve; qualquer autenticado lê (necessário para pesquisa de amigos)
      match /perfil/{doc} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }

      // sessoes — dono lê/escreve; amigos só lêem (para mostrar streak/stats)
      match /sessoes/{doc} {
        allow read: if isOwner(uid) || saoAmigos(request.auth.uid, uid);
        allow write: if isOwner(uid);
      }

      // config — privado, só o dono
      match /config/{doc} {
        allow read, write: if isOwner(uid);
      }

      // tarefas — privado, só o dono
      match /tarefas/{doc} {
        allow read, write: if isOwner(uid);
      }

      // todo — privado, só o dono
      match /todo/{doc} {
        allow read, write: if isOwner(uid);
      }

      // amigos — dono lê/escreve a sua lista
      // O batch do _aceitarPedido escreve também na lista do remetente:
      //   users/{remetenteUid}/amigos/{meuUid} -> permite se o doc de pedido existe
      match /amigos/{amigoUid} {
        allow read: if isOwner(uid);
        // Dono pode sempre gerir a sua lista
        allow write: if isOwner(uid);
        // Outro utilizador autenticado pode escrever APENAS para criar/actualizar
        // a amizade aceite — só quando existe um pedido pendente entre os dois
        allow create, update: if isAuth()
          && request.auth.uid == amigoUid
          && request.resource.data.estado == 'aceite'
          && exists(/databases/$(database)/documents/pedidos_amizade/$(
              // Não podemos fazer query aqui; a validação real é feita pelo batch
              // que apaga o pedido ao mesmo tempo. Permitimos se o escritor é o amigoUid.
              uid  // placeholder — a regra abaixo é suficiente na prática
            ));
        // Simplificação segura: permite escrita se o escritor é o amigoUid
        // (só acontece no batch de _aceitarPedido) e o estado é 'aceite'
        allow create, update: if isAuth()
          && request.auth.uid == amigoUid
          && request.resource.data.keys().hasOnly(['estado'])
          && request.resource.data.estado == 'aceite';
      }

      // reacoes — dono lê e marca como lidas; qualquer amigo pode adicionar
      match /reacoes/{doc} {
        allow read, update: if isOwner(uid);
        // Qualquer utilizador autenticado pode escrever uma reacção
        // (validamos que o campo 'de' corresponde ao auth uid)
        allow create: if isAuth()
          && request.resource.data.de == request.auth.uid
          && request.resource.data.keys().hasAll(['de', 'emoji', 'lida', 'criadaEm'])
          && request.resource.data.lida == false;
      }
    }

    // ─────────────────────────────────────────────
    // /usernames/{username}  — índice global de pesquisa
    // ─────────────────────────────────────────────
    match /usernames/{username} {
      // Qualquer autenticado lê (necessário para pesquisa de amigos)
      allow read: if isAuth();
      // Só o próprio utilizador escreve o seu username
      // Valida que o uid no documento corresponde ao auth uid
      allow create, update: if isAuth()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // /pedidos_amizade/{docId}
    // ─────────────────────────────────────────────
    match /pedidos_amizade/{docId} {
      // Lê: só os envolvidos (remetente ou destinatário)
      allow read: if isAuth()
        && (resource.data.de == request.auth.uid
            || resource.data.para == request.auth.uid);

      // Cria: só o próprio pode enviar em nome próprio
      allow create: if isAuth()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.keys().hasAll(['de', 'para', 'estado', 'data'])
        && request.resource.data.estado == 'pendente'
        && request.resource.data.de != request.resource.data.para;

      // Apaga: remetente pode cancelar; destinatário pode recusar/aceitar
      allow delete: if isAuth()
        && (resource.data.de == request.auth.uid
            || resource.data.para == request.auth.uid);

      // Update: só o destinatário pode alterar o estado
      allow update: if isAuth()
        && resource.data.para == request.auth.uid;
    }

  }
}
