rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    // Verifica que os dois utilizadores são amigos (amizade aceite)
    function saoAmigos(meuUid, amigoUid) {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(meuUid)/amigos/$(amigoUid))
        && get(/databases/$(database)/documents/users/$(meuUid)/amigos/$(amigoUid)).data.estado == 'aceite';
    }
    // Verifica se a conta do utilizador é pública
    function contaPublica(uid) {
      return !get(/databases/$(database)/documents/users/$(uid)/config/dados).data.get('contaPrivada', false);
    }

    // ─────────────────────────────────────────────
    // /users/{uid}  — documento raiz do utilizador
    // ─────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // perfil — dono escreve; qualquer autenticado lê (necessário para pesquisa de amigos e leaderboard)
      match /perfil/{doc} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }

      // sessoes — dono lê/escreve; amigos lêem; qualquer autenticado lê se conta pública (leaderboard)
      match /sessoes/{doc} {
        allow read: if isOwner(uid)
                    || saoAmigos(request.auth.uid, uid)
                    || (isAuth() && contaPublica(uid));
        allow write: if isOwner(uid);
      }

      // config — dono lê/escreve; qualquer autenticado lê (necessário para verificar contaPrivada no leaderboard)
      // Nota: apenas o campo 'contaPrivada' e 'freezeDias' são necessários externamente.
      //       Se quiser restringir ao máximo, separe estes campos num documento público.
      match /config/{doc} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }

      // tarefas — privado, só o dono
      match /tarefas/{doc} {
        allow read, write: if isOwner(uid);
      }

      // todo — privado, só o dono
      match /todo/{doc} {
        allow read, write: if isOwner(uid);
      }

      // amigos — dono lê/escreve a sua lista
      match /amigos/{amigoUid} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
        allow create, update: if isAuth()
          && request.auth.uid == amigoUid
          && request.resource.data.keys().hasOnly(['estado'])
          && request.resource.data.estado == 'aceite';
      }

      // reacoes — dono lê e marca como lidas; qualquer autenticado pode criar
      match /reacoes/{doc} {
        allow read, update: if isOwner(uid);
        allow create: if isAuth()
          && request.resource.data.de == request.auth.uid
          && request.resource.data.keys().hasAll(['de', 'emoji', 'lida', 'criadaEm'])
          && request.resource.data.lida == false;
      }
    }

    // ─────────────────────────────────────────────
    // /usernames/{username}  — índice global de pesquisa
    // ─────────────────────────────────────────────
    match /usernames/{username} {
      allow read: if isAuth();
      allow create, update: if isAuth()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // /pedidos_amizade/{docId}
    // ─────────────────────────────────────────────
    match /pedidos_amizade/{docId} {
      allow read: if isAuth()
        && (resource.data.de == request.auth.uid
            || resource.data.para == request.auth.uid);

      allow create: if isAuth()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.keys().hasAll(['de', 'para', 'estado', 'data'])
        && request.resource.data.estado == 'pendente'
        && request.resource.data.de != request.resource.data.para;

      allow delete: if isAuth()
        && (resource.data.de == request.auth.uid
            || resource.data.para == request.auth.uid);

      allow update: if isAuth()
        && resource.data.para == request.auth.uid;
    }

  }
}
